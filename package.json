{
  "name": "kdpa-agent-box",
  "version": "1.3.0",
  "description": "A shared Linux desktop with Chromium and a password vault for AI agents on a Mac or Linux machine. Agents drive it with playwright-cli; you watch and take over from your phone.",
  "type": "module",
  "license": "MIT",
  "author": "KDPA",
  "bin": {
    "agent-box": "agent-box"
  },
  "files": [
    "agent-box",
    "Containerfile",
    "entrypoint.sh",
    "box-quit-browser",
    "box-vault",
    "box-type",
    "box-tidy",
    "box-pick.mjs",
    "box-door.py",
    "chromium-seccomp.json",
    "agent-box-door.plist",
    "desktop/",
    "skills/"
  ],
  "scripts": {
    "lint": "shellcheck -S warning agent-box box-vault box-quit-browser entrypoint.sh tests/smoke.sh",
    "test": "tests/smoke.sh",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "prepare": "husky || true",
    "update:seccomp": "node scripts/update-seccomp.mjs"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "browser",
    "computer-use",
    "playwright",
    "claude-code",
    "codex",
    "novnc",
    "keepassxc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdpa-llc/agent-box.git"
  },
  "homepage": "https://github.com/kdpa-llc/agent-box#readme",
  "bugs": {
    "url": "https://github.com/kdpa-llc/agent-box/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.2"
  }
}

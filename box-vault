#!/bin/sh
# The box's password manager: one KeePassXC vault inside the box's storage.
# Values never print. Agents type them into the page with `type`; the user edits
# the vault in the KeePassXC window ("Passwords" in the taskbar).
#
#   box-vault init                      create the vault on first start
#   box-vault list                      entry names
#   box-vault add <name> [user] [url]   password read from stdin
#   box-vault rm <name>
#   box-vault type <name> [password|username|totp]   type it into the focused field
#   box-vault gui                       open the KeePassXC window, unlocked
#
# The vault is encrypted (KeePassXC: AES-256, Argon2) and unlocked with a random
# master password kept next to it, so agents can log in while the user is away.
set -eu
DIR=/data/vault
DB=$DIR/vault.kdbx
MASTER=$DIR/.master
export DISPLAY=:1

master() { cat "$MASTER"; echo; }    # the CLI reads the master password from stdin

case "${1:-}" in
  init)
    [ -f "$DB" ] && exit 0
    mkdir -p "$DIR"; chmod 700 "$DIR"
    (umask 077; head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40 > "$MASTER")
    { master; master; } | keepassxc-cli db-create -q -p "$DB" >/dev/null 2>&1
    echo "vault created" ;;
  list)
    master | keepassxc-cli ls -q -R -f "$DB" | grep -v -e '/$' -e '^Recycle Bin/' -e '^\[empty\]$' || true ;;
  add)
    name=${2:?name}; user=${3:-}; url=${4:-}
    pw=$(cat)
    [ -n "$pw" ] || { echo "empty password; nothing saved" >&2; exit 1; }
    { master; printf '%s\n' "$pw"; } | keepassxc-cli add -q -u "$user" --url "$url" -p "$DB" "$name" >/dev/null
    echo "saved '$name'" ;;
  rm)
    master | keepassxc-cli rm -q "$DB" "${2:?name}" >/dev/null
    echo "removed '$2'" ;;
  type)
    name=${2:?name}
    case "${3:-password}" in
      password) value=$(master | keepassxc-cli show -q -s -a Password "$DB" "$name") ;;
      username) value=$(master | keepassxc-cli show -q -a UserName "$DB" "$name") ;;
      totp)     value=$(master | keepassxc-cli show -q -t "$DB" "$name" | tail -n 1) ;;
      *) echo "field must be password, username or totp" >&2; exit 2 ;;
    esac
    [ -n "$value" ] || { echo "'$name' has no ${3:-password}" >&2; exit 1; }
    # Type into Chromium even if the password manager window is in front.
    xdotool search --onlyvisible --class chromium windowactivate --sync %1 2>/dev/null || true
    printf '%s' "$value" | xdotool type --clearmodifiers --delay 15 --file - ;;
  gui)
    if pgrep -x keepassxc >/dev/null; then
      xdotool search --onlyvisible --class keepassxc windowactivate 2>/dev/null || true; exit 0
    fi
    export XDG_RUNTIME_DIR=/tmp/runtime-agent; mkdir -p -m 700 "$XDG_RUNTIME_DIR"
    setsid dbus-run-session -- keepassxc "$DB" </dev/null >/tmp/keepassxc.log 2>&1 &
    # KeePassXC 2.7.10 crashes here when unlocked at startup (--pw-stdin), so
    # type the master password into its normal unlock screen instead.
    win=$(timeout 20 xdotool search --sync --onlyvisible --class keepassxc 2>/dev/null | head -n 1)
    [ -n "$win" ] || { echo "KeePassXC did not open; see /tmp/keepassxc.log" >&2; exit 1; }
    sleep 1
    xdotool windowactivate --sync "$win" 2>/dev/null || true
    [ "$(xdotool getactivewindow)" = "$win" ] || { echo "unlock screen not in front; enter the password manually" >&2; exit 1; }
    cat "$MASTER" | xdotool type --clearmodifiers --delay 5 --file -
    xdotool key Return ;;
  *)
    sed -n '5,11p' "$0"; exit 2 ;;
esac

#!/bin/bash
# agent-box: start, stop and use the shared agent box, one Linux desktop with
# Chromium that AI agents drive and a person can watch and take over.
# The box stops by itself after BOX_IDLE_MINUTES with no viewer and no browser
# control traffic, so `agent-box up` is safe to call before every use.
set -euo pipefail

NAME=${BOX_NAME:-agent-box}   # BOX_NAME only for tests on a second box
VOLUME=${BOX_VOLUME:-agent-box-data}   # BOX_VOLUME, like BOX_NAME, only for tests
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
OS=$(uname -s)
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/agent-box/config"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/agent-box"   # logs and locks
NET=agent-box   # the box's own network, so other containers can't reach its ports
CDP_PORT=${BOX_CDP_PORT:-9222}
VIEW_PORT=${BOX_VIEW_PORT:-6080}
CDP=http://127.0.0.1:$CDP_PORT
VIEW_LOCAL=http://127.0.0.1:$VIEW_PORT/
DOOR=local.agent-box.door
DOOR_PLIST="$HOME/Library/LaunchAgents/$DOOR.plist"
SKILL="$HERE/skills/agent-box"
SKILL_DIRS=("${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills" "$HOME/.agents/skills")   # Claude Code; Codex and other agents

# The image tag is a checksum of the files it's built from, so an update rebuilds it.
BUILD_FILES=(Containerfile entrypoint.sh box-quit-browser box-vault box-type box-tidy desktop/tint2rc desktop/agent-box-passwords.desktop desktop/keepassxc.ini)
TAG=$(cd "$HERE" && cat "${BUILD_FILES[@]}" | cksum | cut -d' ' -f1)
IMAGE="agent-box:$TAG"
STAMP="$CACHE/image-$TAG.built"   # when this image was built, for the browser refresh
REFRESH_DAYS=${BOX_REFRESH_DAYS:-14}

conf_get() { [ -f "$CONF" ] && sed -n "s/^$1=//p" "$CONF" | tail -n 1 || true; }
conf_set() {
  mkdir -p "$(dirname "$CONF")"
  { grep -v "^$1=" "$CONF" 2>/dev/null || true; echo "$1=$2"; } > "$CONF.new" && mv "$CONF.new" "$CONF"
}

# Container tool: Apple's container (Macs with Apple silicon and macOS 26), or
# Docker (Docker Desktop, OrbStack, Colima, Docker Engine on Linux), or Podman.
apple_ok() { [ "$OS" = Darwin ] && [ "$(uname -m)" = arm64 ] && [ "$(sw_vers -productVersion | cut -d. -f1)" -ge 26 ]; }
runtimes_found() {
  if apple_ok && command -v container >/dev/null; then echo container; fi
  if command -v docker >/dev/null; then echo docker; fi
  if command -v podman >/dev/null; then echo podman; fi
  return 0
}
default_runtime() {
  local r; r=$(runtimes_found | sed -n 1p)
  if [ -n "$r" ]; then echo "$r"; elif apple_ok; then echo container; else echo none; fi
}
RT=${BOX_RUNTIME:-$(conf_get runtime)}
[ -n "$RT" ] || RT=$(default_runtime)

if [ "$OS" = Darwin ] && [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
  TS=/Applications/Tailscale.app/Contents/MacOS/Tailscale
else
  TS=tailscale
fi

# With the front door on (agent-box door on, macOS), it owns 6080 and the box's viewer moves to 6090.
# Door services: ours, and any older install that runs box-door.py under another label.
door_plists() {
  if [ "$OS" = Darwin ]; then grep -l 'box-door\.py' "$HOME"/Library/LaunchAgents/*.plist 2>/dev/null; fi
  return 0
}
door_on() {
  local p
  while IFS= read -r p; do
    [ -n "$p" ] && launchctl print "gui/$(id -u)/$(basename "$p" .plist)" >/dev/null 2>&1 && return 0
  done < <(door_plists)
  return 1
}
door_remove() {
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    launchctl bootout "gui/$(id -u)/$(basename "$p" .plist)" 2>/dev/null || true
    rm -f "$p"
  done < <(door_plists)
}
viewer_port() { if [ -z "${BOX_VIEW_PORT:-}" ] && door_on; then echo 6090; else echo "$VIEW_PORT"; fi; }

# Colima and Podman on a Mac run their own Linux VM, which agent-box starts and
# stops. Setup records it, because Colima removes its Docker context when stopped.
VM=$(conf_get vm)
colima_ctx() { [ "$RT" = docker ] && [ "$VM" = colima ] && command -v colima >/dev/null; }
podman_vm() { [ "$RT" = podman ] && [ "$OS" = Darwin ]; }

ensure_system() {
  case "$RT" in
    container)
      container system status >/dev/null 2>&1 || container system start --disable-kernel-install >/dev/null ;;
    docker|podman)
      "$RT" info >/dev/null 2>&1 && return 0
      if colima_ctx; then colima start >/dev/null 2>&1 || true
      elif podman_vm; then podman machine start >/dev/null 2>&1 || true; fi
      if "$RT" info 2>&1 | grep -i 'permission denied' >/dev/null; then
        echo "agent-box: $RT says permission denied. Add yourself to its group: sudo usermod -aG docker \$USER, then log out and back in" >&2; exit 1
      fi
      "$RT" info >/dev/null 2>&1 || {
        echo "agent-box: $RT isn't running. Start it (Docker Desktop, OrbStack, 'colima start' or 'podman machine start') and try again" >&2; exit 1; } ;;
    *)
      echo "agent-box: no container tool found; run 'agent-box setup'" >&2; exit 1 ;;
  esac
}
# Stop the container service or VM too, unless other containers still use it.
stop_system() {
  local what others
  if [ "$RT" = container ]; then what="container service"
  elif colima_ctx; then what="Colima VM"
  elif podman_vm; then what="Podman VM"
  else return 0; fi
  if [ "$RT" = container ]; then others=$(container list -q 2>/dev/null | grep -vx "$NAME" || true)
  else others=$("$RT" ps -q 2>/dev/null || true); fi
  if [ -n "$others" ]; then echo "agent-box: left the $what running, because other containers use it"; return 0; fi
  case "$what" in
    "container service") container system stop ;;
    "Colima VM") colima stop ;;
    "Podman VM") podman machine stop ;;
  esac >/dev/null 2>&1 || true
  echo "agent-box: $what stopped"
}

state() {
  local s=""
  if [ "$RT" = container ]; then
    if container list -q 2>/dev/null | grep -x "$NAME" >/dev/null; then s=running
    elif container list -a -q 2>/dev/null | grep -x "$NAME" >/dev/null; then s=stopped; fi
  else
    s=$("$RT" inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null) || true
  fi
  echo "${s:-absent}"
}
running() { [ "$(state)" = running ]; }
need_box() { running || { echo "agent-box: not running (run 'agent-box up')" >&2; exit 1; }; }
in_box() { "$RT" exec "$@"; }   # in_box [-i] [-u agent] <container> <cmd...>
vault() { in_box -u agent "$NAME" box-vault "$@"; }

image_ok() { "$RT" image inspect "$IMAGE" >/dev/null 2>&1; }
image_tags() {
  if [ "$RT" = container ]; then container image list -q 2>/dev/null | sed -n 's/^agent-box://p'
  else "$RT" images agent-box --format '{{.Tag}}' 2>/dev/null; fi
  return 0
}
image_rm() { if [ "$RT" = container ]; then container image delete "$1"; else "$RT" image rm "$1"; fi; }

# One start, and one image build, at a time: several agents may run `up` at once.
LOCKS=()
release_locks() { local l; for l in ${LOCKS[@]+"${LOCKS[@]}"}; do rm -rf "$l"; done; }
trap 'rc=$?; release_locks; exit "$rc"' EXIT   # keep the command's own exit code
lock() {
  local dir="$CACHE/$1.lock" i p
  mkdir -p "$CACHE"
  for i in $(seq 900); do
    if mkdir "$dir" 2>/dev/null; then echo $$ > "$dir/pid"; LOCKS+=("$dir"); return 0; fi
    p=$(cat "$dir/pid" 2>/dev/null || true)
    if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$dir"; continue; fi   # its owner died
    if [ -z "$p" ] && [ "$i" -gt 5 ]; then rm -rf "$dir"; continue; fi
    sleep 1
  done
  echo "agent-box: waited 15 minutes for another agent-box command; if none is running, remove $dir" >&2
  exit 1
}
unlock() { rm -rf "$CACHE/$1.lock"; }
locked() { [ -d "$CACHE/$1.lock" ]; }

# Run a command in its own session, so it outlives the agent's shell command.
detach() { python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@"; }

# Make sure the image exists. A build takes 1 to 3 minutes, longer than agents'
# commands may run, so it builds in the background and `up` waits a while for it.
# Returns 75 if it isn't ready yet.
prepare_image() {
  image_ok && return 0
  local wait=${BOX_PREPARE_WAIT:-100} i
  [ -t 1 ] && wait=1800   # a person at a terminal: just wait
  mkdir -p "$CACHE"
  if ! locked build; then
    echo "agent-box: preparing the box image (first run or after an update, 1 to 3 minutes)" >&2
    detach "$0" build --if-missing >"$CACHE/build.log" 2>&1 </dev/null &
  fi
  for i in $(seq "$wait"); do image_ok && return 0; sleep 1; done
  echo "agent-box: still preparing the image; run the same command again in a minute (progress: tail $CACHE/build.log)" >&2
  return 75
}

# Rebuild, in the background, an image older than BOX_REFRESH_DAYS, so the
# browser gets security updates. The box uses it from its next start.
refresh_image() {
  case $REFRESH_DAYS in ''|*[!0-9]*|0) return 0 ;; esac
  mkdir -p "$CACHE"
  [ -f "$STAMP" ] || { date +%s > "$STAMP"; return 0; }
  local built; built=$(cat "$STAMP" 2>/dev/null || echo 0)
  case $built in ''|*[!0-9]*) built=0 ;; esac
  [ $(( $(date +%s) - built )) -ge $(( REFRESH_DAYS * 86400 )) ] || return 0
  locked build && return 0
  echo "agent-box: the browser image is over $REFRESH_DAYS days old; updating it in the background (used from the next start)" >&2
  detach "$0" build >"$CACHE/build.log" 2>&1 </dev/null &
}

# The box's own network, where the container tool supports one.
network_opts() {
  if "$RT" network inspect "$NET" >/dev/null 2>&1 || "$RT" network create "$NET" >/dev/null 2>&1; then
    echo "--network $NET"
  fi
}

# The host's time zone, so sites show local times.
host_tz() {
  local z
  for z in "${TZ:-}" "$(readlink /etc/localtime 2>/dev/null | sed -n 's#.*/zoneinfo/##p')" "$(cat /etc/timezone 2>/dev/null || true)"; do
    case $z in ''|*[!A-Za-z0-9_+/-]*) ;; *) echo "$z"; return ;; esac
  done
  echo UTC
}

# True once the browser answers; false if the box stops while we wait.
wait_cdp() {
  local i
  for i in $(seq 120); do
    curl -sf -m 1 "$CDP/json/version" >/dev/null && return 0
    if [ $(( i % 10 )) -eq 0 ] && ! running; then return 1; fi
    sleep 0.5
  done
  return 1
}

start_box() {
  [ "$(state)" = absent ] || "$RT" rm -f "$NAME" >/dev/null 2>&1 || true   # a stopped box blocks the name
  prepare_image || exit 75
  if ! "$RT" volume inspect "$VOLUME" >/dev/null 2>&1; then
    if [ "$RT" = container ]; then container volume create -s 4G "$VOLUME" >/dev/null
    else "$RT" volume create "$VOLUME" >/dev/null; fi
  fi
  # Apple's container runs each box in its own VM. Docker and Podman share one
  # kernel and block the user namespaces Chromium's sandbox needs, so they get
  # a seccomp profile: Docker's default plus clone, setns and unshare
  # (scripts/update-seccomp.mjs regenerates it).
  local extra net
  if [ "$RT" = container ]; then extra=(-c "${BOX_CPUS:-2}")
  else extra=(--cpus "${BOX_CPUS:-2}" --security-opt "seccomp=$HERE/chromium-seccomp.json"); fi
  read -r -a net <<< "$(network_opts)"
  mkdir -p "$CACHE"
  "$RT" run -d --rm --name "$NAME" --init \
    -m "${BOX_MEMORY:-2G}" "${extra[@]}" ${net[@]+"${net[@]}"} --shm-size 1G \
    -e IDLE_MINUTES="${BOX_IDLE_MINUTES:-20}" -e TZ="$(host_tz)" \
    -e TAB_STALE_MINUTES="${BOX_TAB_STALE_MINUTES:-180}" -e TAB_FLOOR_PERCENT="${BOX_TAB_FLOOR_PERCENT:-15}" \
    -e SCREEN_WIDTH="${BOX_WIDTH:-1280}" -e SCREEN_HEIGHT="${BOX_HEIGHT:-800}" \
    -v "$VOLUME":/data \
    -p "127.0.0.1:$(viewer_port):6080" -p "127.0.0.1:$CDP_PORT:9223" \
    "$IMAGE" >"$CACHE/run.log" 2>&1 || running || { cat "$CACHE/run.log" >&2; exit 1; }
}

# Phone viewer address, only once it's published on the tailnet (see README).
view_tailnet() {
  "$TS" serve status 2>/dev/null | grep ':8443' >/dev/null || return 1
  local host
  host=$("$TS" status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null) || return 1
  echo "https://$host:8443/"
}

info() {
  echo "agent-box: running ($RT)"
  echo "  browser control (CDP): $CDP"
  echo "  viewer on this machine: $VIEW_LOCAL"
  local t
  if t=$(view_tailnet); then echo "  viewer from phone:      $t (Tailscale)"
  else echo "  viewer from phone:      not published (see $HERE/README.md)"; fi
  local idle hold
  idle=$(in_box "$NAME" printenv IDLE_MINUTES 2>/dev/null || echo "${BOX_IDLE_MINUTES:-20}")
  hold=$(in_box "$NAME" sh -c 'h=$(cat /tmp/box-hold-until 2>/dev/null || echo 0); n=$(date +%s); [ "$h" -gt "$n" ] && echo $(( (h - n + 59) / 60 ))' 2>/dev/null || true)
  if [ "$idle" = 0 ]; then echo "  never stops by itself; 'agent-box down' stops it"
  else echo "  stops after $idle min idle${hold:+ (kept awake for $hold more min)}; 'agent-box down' stops it now"; fi
  echo "  downloads: 'agent-box files' lists them, 'agent-box get <name>' copies one here"
}

case "${1:-help}" in
  setup)
    # One-time install on this machine; safe to re-run, for example after an update.
    shift; skills=1; dirs=(); want=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --skills-dir) dirs+=("${2:?--skills-dir needs a folder}"); shift 2 ;;
        --no-skills) skills=0; shift ;;
        --runtime) want="${2:?--runtime needs container, docker or podman}"; shift 2 ;;
        *) echo "usage: agent-box setup [--runtime container|docker|podman] [--skills-dir DIR]... [--no-skills]" >&2; exit 2 ;;
      esac
    done
    ask() { [ -t 0 ] && [ -t 1 ]; }   # a person at a terminal; agents pass options instead
    case "$OS" in Darwin|Linux) ;; *) echo "agent-box: needs macOS or Linux" >&2; exit 1 ;; esac

    # 1. Which container tool.
    if [ -z "$want" ]; then
      found=$(runtimes_found | tr '\n' ' ')
      want=$(default_runtime)
      if ask && [ "$(echo "$found" | wc -w)" -gt 1 ]; then
        printf 'Container tools found: %s\nWhich one should run the box? Press Enter for %s, or type another: ' "$found" "$want"
        read -r answer || answer=""
        [ -z "$answer" ] || want=$answer
      fi
    fi
    case "$want" in
      container) apple_ok || { echo "agent-box: Apple's container needs a Mac with Apple silicon and macOS 26; use --runtime docker or podman" >&2; exit 1; } ;;
      docker|podman) command -v "$want" >/dev/null || { echo "agent-box: $want isn't installed" >&2; exit 1; } ;;
      none) echo "agent-box: install Docker (Docker Desktop, OrbStack, Colima or Docker Engine) or Podman, then run setup again" >&2; exit 1 ;;
      *) echo "agent-box: unknown container tool '$want' (container, docker or podman)" >&2; exit 2 ;;
    esac
    RT=$want

    # 2. Where the agent skill goes.
    if [ "$skills" = 1 ] && [ ${#dirs[@]} -eq 0 ]; then
      dirs=("${SKILL_DIRS[@]}")
      if ask; then
        echo "Agents learn to use the box from a skill. It goes in these folders by default:"
        printf '  %s\n' "${dirs[@]}"
        printf 'Add it there? Press Enter for yes, type n for no, or type other folders: '
        read -r answer || answer=""
        case "$answer" in
          ""|y|Y|yes) ;;
          n|N|no) skills=0 ;;
          *) read -r -a dirs <<< "$answer"; dirs=("${dirs[@]/#\~/$HOME}") ;;
        esac
      fi
    fi

    # 3. Tools, image and skill.
    if [ "$RT" = container ] && ! command -v container >/dev/null; then
      command -v brew >/dev/null || { echo "agent-box: install Homebrew first, or Apple's container from https://github.com/apple/container/releases" >&2; exit 1; }
      echo "agent-box: installing Apple's container tool (Homebrew)"
      brew install container
    fi
    if ! command -v playwright-cli >/dev/null; then
      echo "agent-box: installing playwright-cli (npm)"
      npm install -g @playwright/cli@latest || {
        echo "agent-box: npm couldn't install playwright-cli for everyone. If it needs sudo, give npm a folder of your own:" >&2
        echo "  npm config set prefix ~/.npm-global, add ~/.npm-global/bin to PATH, then run agent-box setup again" >&2
        exit 1; }
    fi
    if [ "$RT" = container ]; then
      container system status >/dev/null 2>&1 || container system start --enable-kernel-install
    else
      ensure_system
    fi
    conf_set runtime "$RT"
    if [ "$RT" = docker ] && [ "$(docker context show 2>/dev/null)" = colima ]; then conf_set vm colima; else conf_set vm none; fi
    prepared=1; prepare_image || prepared=0
    if [ "$skills" = 1 ]; then conf_set skill_dirs "$(IFS=:; echo "${dirs[*]}")"; else conf_set skill_dirs none; fi
    if [ "$skills" = 1 ]; then
      for d in "${dirs[@]}"; do
        if [ -e "$d/agent-box" ] && [ ! -L "$d/agent-box" ]; then
          echo "agent-box: skipped $d: it already has an agent-box folder that isn't a link" >&2; continue
        fi
        mkdir -p "$d"; ln -sfn "$SKILL" "$d/agent-box"
        echo "agent-box: skill linked in $d"
      done
      echo "agent-box: ready, using $RT. New agent sessions find the 'agent-box' skill. Watch the box at $VIEW_LOCAL"
    else
      echo "agent-box: ready, using $RT, without the skill: point agents at $SKILL/SKILL.md. Watch the box at $VIEW_LOCAL"
    fi
    [ "$prepared" = 1 ] || echo "  The box image is still being prepared in the background; the first 'agent-box up' finishes it."
    echo "  For the phone viewer and password vault, see $HERE/README.md. To check everything: agent-box doctor" ;;
  uninstall)
    # Undo setup. --all also deletes the image and the box's storage (logins and password vault).
    shift; all=0; dirs=("${SKILL_DIRS[@]}")
    while [ $# -gt 0 ]; do
      case "$1" in
        --all) all=1; shift ;;
        --skills-dir) dirs+=("${2:?--skills-dir needs a folder}"); shift 2 ;;
        *) echo "usage: agent-box uninstall [--skills-dir DIR]... [--all]" >&2; exit 2 ;;
      esac
    done
    for d in "${dirs[@]}"; do
      if [ -L "$d/agent-box" ]; then rm "$d/agent-box"; echo "agent-box: removed the skill from $d"; fi
    done
    if door_on; then "$0" door off; fi
    if [ "$all" = 1 ]; then
      if running; then "$0" down >/dev/null; fi
      ensure_system
      for t in $(image_tags); do image_rm "agent-box:$t" >/dev/null 2>&1 || true; done
      "$RT" volume rm "$VOLUME" >/dev/null 2>&1 || true
      echo "agent-box: deleted the image and the box's storage"
    fi
    "$0" off
    rm -f "$CONF"
    echo "agent-box: uninstalled. Finish with: npm rm -g kdpa-agent-box" ;;
  up)
    ensure_system
    for attempt in 1 2 3; do
      if ! running; then
        lock "start-$NAME"
        running || start_box
        unlock "start-$NAME"
      fi
      wait_cdp && break
      if running; then echo "agent-box: the box runs but its browser doesn't answer; see 'agent-box logs'" >&2; exit 1; fi
      # It stopped while we waited, for example an idle stop that was under way: start it again.
      [ "$attempt" -lt 3 ] || { echo "agent-box: the box keeps stopping while it starts; see 'agent-box doctor'" >&2; exit 1; }
    done
    refresh_image
    info ;;
  down)
    if running; then
      # Quit Chromium cleanly first; a plain stop signal can kill it unsaved.
      in_box "$NAME" box-quit-browser >/dev/null 2>&1 || true
      "$RT" stop -t 15 "$NAME" >/dev/null
    fi
    for _ in $(seq 20); do [ "$(state)" = absent ] && break; sleep 0.5; done
    echo "agent-box: stopped" ;;
  status)
    if running; then
      info
      browser=$(curl -s -m 2 "$CDP/json/version" | sed -n 's/.*"Browser": *"\([^"]*\)".*/\1/p')
      age=""; [ -f "$STAMP" ] && age=$(( ( $(date +%s) - $(cat "$STAMP") ) / 86400 ))
      echo "  browser: ${browser:-not answering}${age:+, image built $age days ago}"
      "$RT" stats --no-stream "$NAME" 2>/dev/null || true
    else echo "agent-box: stopped (run 'agent-box up'); container tool: $RT"; fi ;;
  url)
    echo "$VIEW_LOCAL"; view_tailnet || true ;;
  shot)
    # Screenshot of the whole desktop, for when the page alone is not enough.
    need_box
    out="${2:-/tmp/agent-box-$(date +%Y%m%d-%H%M%S)-$$.png}"
    in_box "$NAME" sh -c "DISPLAY=:1 scrot -o /tmp/shot-$$.png"
    in_box "$NAME" cat "/tmp/shot-$$.png" > "$out"; in_box "$NAME" rm -f "/tmp/shot-$$.png"; echo "$out" ;;
  x)
    # Raw mouse/keyboard on the desktop, e.g. `agent-box x mousemove 640 400 click 1`.
    shift; in_box "$NAME" env DISPLAY=:1 xdotool "$@" ;;
  exec)
    shift; in_box "$NAME" "$@" ;;
  logs)
    "$RT" logs "$NAME" ;;
  build)
    # Always with current packages (--pull --no-cache), so the browser gets its
    # security updates. --if-missing: only if this version's image isn't there yet.
    [ "${2:-}" = --if-missing ] && if_missing=1 || if_missing=0
    ensure_system
    lock build
    if [ "$if_missing" = 1 ] && image_ok; then exit 0; fi
    "$RT" build --pull --no-cache -t "$IMAGE" -f "$HERE/Containerfile" "$HERE"
    mkdir -p "$CACHE"; date +%s > "$STAMP"
    # Drop the build cache (about 4.5 GB with Apple's container), older builds and unused layers.
    if [ "$RT" = container ]; then
      container builder stop >/dev/null 2>&1 || true
      container builder delete >/dev/null 2>&1 || true
    fi
    for t in $(image_tags); do
      [ "$t" = "$TAG" ] || image_rm "agent-box:$t" >/dev/null 2>&1 || true
    done
    if [ "$RT" = container ]; then container image prune >/dev/null 2>&1 || true
    else "$RT" image prune -f --filter label=agent-box >/dev/null 2>&1 || true; fi ;;
  door)
    # Front door (macOS): always-on 15 MB helper on 6080 that starts the box when
    # the viewer address is opened and shows a "starting" page meanwhile.
    [ "$OS" = Darwin ] || { echo "agent-box: the front door is only for macOS so far" >&2; exit 1; }
    agents="$HOME/Library/LaunchAgents"
    case "${2:-}" in
      on)
        was_on=0; door_on && was_on=1
        door_remove
        mkdir -p "$agents" "$HOME/Library/Logs"
        path="$(dirname "$(command -v "$RT")"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        sed -e "s|__HERE__|$HERE|g" -e "s|__LABEL__|$DOOR|" -e "s|__PATH__|$path|" \
            -e "s|__LOG__|$HOME/Library/Logs/agent-box-door.log|" "$HERE/agent-box-door.plist" > "$DOOR_PLIST"
        if [ "$was_on" = 0 ] && running; then "$0" down >/dev/null; fi   # its viewer must move to 6090
        launchctl bootstrap "gui/$(id -u)" "$DOOR_PLIST"
        echo "agent-box: front door on; open the viewer address any time" ;;
      off)
        door_remove
        if running; then "$0" down >/dev/null; fi
        echo "agent-box: front door off" ;;
      *) door_on && echo "agent-box: front door on" || echo "agent-box: front door off" ;;
    esac ;;
  secret)
    # The box's password manager (KeePassXC, inside the box). Values never print.
    # New passwords come from a private secret prompt that writes a file
    # (T3 Code: request_secret with delivery "file"), so they never enter the chat.
    need_box
    case "${2:-}" in
      save)
        # agent-box secret save <name> --from-file <path> [--user <username>] [--url <url>]
        name="${3:-}"; shift 3 || true
        file=""; user=""; url=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --from-file) file="${2:-}"; shift 2 ;;
            --user) user="${2:-}"; shift 2 ;;
            --url) url="${2:-}"; shift 2 ;;
            *) echo "agent-box: unknown option $1" >&2; exit 2 ;;
          esac
        done
        [ -n "$name" ] && [ -f "$file" ] || { echo "usage: agent-box secret save <name> --from-file <path> [--user <username>] [--url <url>]" >&2; exit 2; }
        tr -d '\r\n' < "$file" | in_box -i -u agent "$NAME" box-vault add "$name" "$user" "$url" ;;
      list) vault list ;;
      rm)   vault rm "${3:?usage: agent-box secret rm <name>}" ;;
      open) vault gui; echo "agent-box: the password manager is open on the box's screen" ;;
      *) echo "usage: agent-box secret save <name> --from-file <path> [--user U] [--url URL] | list | rm <name> | open" >&2; exit 2 ;;
    esac ;;
  type-secret)
    # Type a vault entry into the field the agent focused, without printing it.
    #   agent-box type-secret <name> [--username | --totp] [--no-enter] [--page <text>] [--keyboard]
    #   agent-box type-secret --from-file <path> [--url <site>] [...]       (one-time use)
    # It types into the one page whose focused field is the right kind (a password
    # field for passwords), on the entry's site, whatever tab is in front. For
    # passwords it presses Enter, then clears password fields on that page:
    # page snapshots show their text.
    shift; need_box
    field=password; enter=1; name=""; file=""; url=""; opts=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --username) field=username; enter=0; shift ;;
        --totp) field=totp; shift ;;
        --no-enter) enter=0; shift ;;
        --from-file) file="${2:-}"; shift 2 ;;
        --url) url="${2:-}"; shift 2 ;;
        --page) opts+=(--page "${2:?--page needs part of the page address or title}"); shift 2 ;;
        --keyboard) opts+=(--keyboard); shift ;;
        -*) echo "agent-box: unknown option $1" >&2; exit 2 ;;
        *) name="$1"; shift ;;
      esac
    done
    [ "$enter" = 1 ] && opts+=(--enter)
    [ "$enter" = 1 ] && [ "$field" = password ] && opts+=(--clear-after 3)
    rc=0
    if [ -n "$file" ]; then
      [ -f "$file" ] || { echo "agent-box: no such file" >&2; exit 2; }
      tr -d '\r\n' < "$file" | in_box -i -u agent "$NAME" env DISPLAY=:1 box-type --kind "$field" --url "$url" ${opts[@]+"${opts[@]}"} || rc=$?
    else
      [ -n "$name" ] || { echo "usage: agent-box type-secret <name> [--username|--totp] [--no-enter] [--page <text>]" >&2; exit 2; }
      vault type "$name" "$field" ${opts[@]+"${opts[@]}"} || rc=$?
    fi
    [ "$rc" = 0 ] || exit "$rc"
    if [ "$enter" = 0 ] && [ "$field" = password ]; then
      echo "agent-box: submit the form before any snapshot (snapshots show password fields)"
    fi ;;
  files)
    # Downloads the box saved, newest first.
    need_box
    list=$(in_box "$NAME" find /data/Downloads -maxdepth 1 -type f -printf '%T@\t%TY-%Tm-%Td %TH:%TM\t%s\t%f\n' 2>/dev/null | sort -rn || true)
    if [ -z "$list" ]; then echo "agent-box: no downloads yet"; exit 0; fi
    printf '%s\n' "$list" | awk -F'\t' '{ n = $4; note = "";
      if (n ~ /\.crdownload$/) { sub(/\.crdownload$/, "", n); note = "  (still downloading)" }
      printf "%s  %10s  %s%s\n", $2, $3, n, note }' ;;
  get)
    # agent-box get <name>|--latest [destination]: copy a download out of the box.
    need_box
    name="${2:-}"; dest="${3:-.}"
    if [ "$name" = --latest ]; then
      name=$(in_box "$NAME" sh -c 'ls -1t /data/Downloads 2>/dev/null | grep -v "\.crdownload$" | head -n 1' || true)
      [ -n "$name" ] || { echo "agent-box: no finished downloads yet" >&2; exit 1; }
    fi
    case "$name" in ''|*/*|.|..) echo "usage: agent-box get <name>|--latest [destination] (names from agent-box files)" >&2; exit 2 ;; esac
    if in_box "$NAME" test -f "/data/Downloads/$name.crdownload"; then
      echo "agent-box: '$name' is still downloading; try again shortly" >&2; exit 1
    fi
    in_box "$NAME" test -f "/data/Downloads/$name" || { echo "agent-box: no download named '$name'; see agent-box files" >&2; exit 1; }
    [ -d "$dest" ] && dest="${dest%/}/$name"
    in_box "$NAME" cat "/data/Downloads/$name" > "$dest.part" && mv "$dest.part" "$dest"
    echo "$dest" ;;
  hold)
    # Keep the box awake while you work elsewhere: agent-box hold <minutes> (0 ends it).
    need_box
    m="${2:-}"
    case "$m" in ''|*[!0-9]*) echo "usage: agent-box hold <minutes> (at most 1440; 0 ends the hold)" >&2; exit 2 ;; esac
    [ "$m" -le 1440 ] || { echo "agent-box: hold for at most 1440 minutes (a day)" >&2; exit 2; }
    if [ "$m" = 0 ]; then
      in_box "$NAME" rm -f /tmp/box-hold-until
      echo "agent-box: hold ended; the box stops after the usual idle time"
    else
      in_box "$NAME" sh -c 'echo $(( $(date +%s) + '"$m"' * 60 )) > /tmp/box-hold-until'
      echo "agent-box: kept awake for $m minutes, even with nothing connected"
    fi ;;
  tabs)
    # The open tabs, longest idle first, and how much memory is free.
    need_box
    in_box -u agent "$NAME" box-tidy list ;;
  tidy)
    # agent-box tidy [minutes]: close tabs idle that long (default 60).
    # agent-box tidy log: what was closed, when and why.
    need_box
    case "${2:-60}" in
      log) in_box -u agent "$NAME" box-tidy log ;;
      *[!0-9]*) echo "usage: agent-box tidy [minutes] | agent-box tidy log" >&2; exit 2 ;;
      *) in_box -u agent "$NAME" box-tidy run --older-than "${2:-60}" ;;
    esac ;;
  doctor)
    # Check the setup and say how to fix what's wrong.
    bad=0
    pass() { printf '  ok   %s\n' "$1"; }
    note() { printf '  --   %s\n' "$1"; }
    fail() { printf '  FAIL %s\n       fix: %s\n' "$1" "$2"; bad=1; }
    port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
    echo "agent-box $(sed -n 's/^ *"version": *"\(.*\)".*/\1/p' "$HERE/package.json") on $OS $(uname -m), container tool: $RT"
    if command -v python3 >/dev/null && python3 -c 1 >/dev/null 2>&1; then pass "python3"
    else fail "python3 is missing (or is macOS's install stub)" "install the Command Line Tools (xcode-select --install) or Python 3"; fi
    command -v curl >/dev/null && pass "curl" || fail "curl is missing" "install curl"
    usable=0
    case "$RT" in
      container)
        if ! command -v container >/dev/null; then fail "Apple's container isn't installed" "agent-box setup (or brew install container)"
        elif container system status >/dev/null 2>&1; then pass "Apple's container is running"; usable=1
        else note "Apple's container service is stopped; agent-box up starts it"; fi ;;
      docker|podman)
        if ! command -v "$RT" >/dev/null; then fail "$RT isn't installed" "install it, or run agent-box setup --runtime <tool>"
        elif out=$("$RT" info 2>&1); then pass "$RT is running"; usable=1
        elif echo "$out" | grep -i 'permission denied' >/dev/null; then fail "$RT says permission denied" "sudo usermod -aG docker \$USER, then log out and back in"
        elif colima_ctx; then note "Colima is stopped; agent-box up starts it"
        else fail "$RT isn't running" "start Docker Desktop or OrbStack, or run colima start or podman machine start"; fi ;;
      *) fail "no container tool chosen" "agent-box setup" ;;
    esac
    if [ "$usable" = 1 ]; then
      if image_ok; then
        age=""; [ -f "$STAMP" ] && age=" ($(( ( $(date +%s) - $(cat "$STAMP") ) / 86400 )) days old)"
        pass "box image for this version is ready$age"
      elif locked build; then note "box image is being prepared now (progress: tail $CACHE/build.log)"
      else note "box image isn't built yet; the next agent-box up prepares it (1 to 3 minutes)"; fi
      if running; then
        pass "box is running"
        if browser=$(curl -sf -m 2 "$CDP/json/version"); then
          pass "browser answers on $CDP ($(printf '%s' "$browser" | sed -n 's/.*"Browser": *"\([^"]*\)".*/\1/p'))"
        else fail "browser doesn't answer on $CDP" "agent-box logs; then agent-box down && agent-box up"; fi
        curl -sf -m 2 -o /dev/null "http://127.0.0.1:$(viewer_port)/vnc.html" && pass "viewer answers" || fail "viewer doesn't answer" "agent-box logs"
      else
        note "box is stopped; agent-box up starts it"
        port_busy "$CDP_PORT" && fail "port $CDP_PORT is taken by something else" "stop it, or set BOX_CDP_PORT to a free port"
        port_busy "$(viewer_port)" && fail "port $(viewer_port) is taken by something else" "stop it, or set BOX_VIEW_PORT to a free port"
      fi
    fi
    command -v playwright-cli >/dev/null && pass "playwright-cli is installed" || fail "playwright-cli isn't installed" "npm install -g @playwright/cli@latest"
    skill_dirs=$(conf_get skill_dirs); [ -n "$skill_dirs" ] || skill_dirs=$(IFS=:; echo "${SKILL_DIRS[*]}")
    if [ "$skill_dirs" = none ]; then note "the agent skill isn't linked (setup ran with --no-skills)"
    else
      IFS=: read -r -a sdirs <<< "$skill_dirs"; linked=0
      for d in "${sdirs[@]}"; do
        if [ -f "$d/agent-box/SKILL.md" ]; then pass "agent skill linked in $d"; linked=1
        elif [ -L "$d/agent-box" ]; then fail "the skill link in $d is broken" "agent-box setup"; linked=1; fi
      done
      [ "$linked" = 1 ] || fail "the agent skill isn't linked, so agents won't know the box" "agent-box setup"
    fi
    prefix=$(npm prefix -g 2>/dev/null || true)
    if [ -n "$prefix" ] && { [ -w "$prefix/lib/node_modules" ] || [ -w "$prefix/lib" ]; }; then pass "npm can update agent-box without sudo"
    elif [ -n "$prefix" ]; then note "npm's global folder needs sudo, so updates do too"; fi
    if command -v "$TS" >/dev/null 2>&1 || [ -x "$TS" ]; then
      if t=$(view_tailnet); then pass "phone viewer published at $t"
      else note "phone viewer not published (optional; see the README)"; fi
    fi
    if [ "$OS" = Darwin ] && door_on; then
      script=$(door_plists | head -n 1 | xargs grep -o '/[^<]*box-door\.py' 2>/dev/null | head -n 1)
      if [ -n "$script" ] && [ -f "$script" ]; then pass "front door is on"
      else fail "the front door points to an install that's gone" "agent-box door on"; fi
    fi
    free=$(df -Pk "$HOME" | awk 'NR == 2 { print int($4 / 1048576) }')
    if [ "$free" -ge 6 ]; then pass "$free GB free on disk"
    else fail "only $free GB free on disk" "free some space: the image needs about 2 GB, and a build up to 5 GB more for a while"; fi
    exit "$bad" ;;
  off)
    # Stop the box, and the container service or VM when nothing else uses it.
    if running; then "$0" down >/dev/null; fi
    echo "agent-box: box stopped"
    stop_system ;;
  runtime)
    echo "$RT" ;;
  version|--version)
    sed -n 's/^ *"version": *"\(.*\)".*/\1/p' "$HERE/package.json" ;;
  *)
    cat <<'EOF'
agent-box up       start the box if needed (about 7 s) and print its addresses
agent-box down     stop the box now (it also stops itself when idle)
agent-box status   whether it runs, and its CPU and memory use
agent-box url      viewer addresses (this machine, and phone over Tailscale)
agent-box shot [file.png]   screenshot of the whole desktop
agent-box x <xdotool args>  mouse and keyboard on the desktop
agent-box exec <cmd>        run a command inside the box
agent-box logs     the box's log
agent-box files    downloads the box saved, newest first
agent-box get <name>|--latest [dest]   copy a download out of the box
agent-box hold <minutes>   keep the box awake that long even when idle (0 ends it)
agent-box tabs     open tabs, longest idle first, and free memory
agent-box tidy [minutes]   close tabs idle that long (default 60); `tidy log` shows closures
agent-box doctor   check the setup and say how to fix what's wrong
agent-box runtime  the container tool in use (container, docker or podman)
agent-box build    rebuild the image with current packages
agent-box off      stop the box, and the container service or VM if nothing else uses it
agent-box door on|off   (macOS) always-on helper so the viewer address starts the box itself
agent-box setup [--runtime container|docker|podman] [--skills-dir DIR]... [--no-skills]
                   install tools, image and agent skill (re-run after updates)
agent-box uninstall [--all]   undo setup; --all also deletes logins and passwords

Passwords (KeePassXC vault inside the box; values never print):
agent-box secret list                 entry names
agent-box secret save <name> --from-file <path> [--user U] [--url URL]
                                      add one (file from a private secret prompt)
agent-box secret rm <name>            delete one
agent-box secret open                 open the password manager on the box's screen
agent-box type-secret <name> [--username | --totp] [--no-enter] [--page <text>]
                 click the field first; it types into that field, on the entry's
                 site only. For passwords it presses Enter, then clears password
                 fields on that page.

Agents: read the agent-box skill. In short: `agent-box up`, then
`playwright-cli -s=<your-session> attach --cdp=<the browser control address it printed>`,
drive the page (tab-new, find, click, screenshot), close your tab with
`playwright-cli -s=<your-session> tab-close` as soon as you are done with it,
and finish with `detach`. Everyone shares the box's memory.
Never put a password in a command, file or chat: use agent-box type-secret.
EOF
    ;;
esac

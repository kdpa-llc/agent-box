#!/bin/bash
# agent-box: start, stop and use the shared agent box, one Linux desktop with
# Chromium that AI agents drive and a person can watch and take over.
# The box stops by itself after BOX_IDLE_MINUTES with no viewer and no browser
# control traffic, so `agent-box up` is safe to call before every use.
set -euo pipefail

NAME=${BOX_NAME:-agent-box}   # BOX_NAME only for tests on a second box
VOLUME=${BOX_VOLUME:-agent-box-data}   # BOX_VOLUME, like BOX_NAME, only for tests
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
OS=$(uname -s)
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/agent-box/config"
CDP_PORT=${BOX_CDP_PORT:-9222}
VIEW_PORT=${BOX_VIEW_PORT:-6080}
CDP=http://127.0.0.1:$CDP_PORT
VIEW_LOCAL=http://127.0.0.1:$VIEW_PORT/
DOOR=local.agent-box.door
DOOR_PLIST="$HOME/Library/LaunchAgents/$DOOR.plist"
SKILL="$HERE/skills/agent-box"
SKILL_DIRS=("${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills" "$HOME/.agents/skills")   # Claude Code; Codex and other agents

# The image tag is a checksum of the files it's built from, so an update rebuilds it.
BUILD_FILES=(Containerfile entrypoint.sh box-quit-browser box-vault desktop/tint2rc desktop/agent-box-passwords.desktop desktop/keepassxc.ini)
TAG=$(cd "$HERE" && cat "${BUILD_FILES[@]}" | cksum | cut -d' ' -f1)
IMAGE="agent-box:$TAG"

conf_get() { [ -f "$CONF" ] && sed -n "s/^$1=//p" "$CONF" | tail -n 1 || true; }
conf_set() {
  mkdir -p "$(dirname "$CONF")"
  { grep -v "^$1=" "$CONF" 2>/dev/null || true; echo "$1=$2"; } > "$CONF.new" && mv "$CONF.new" "$CONF"
}

# Container tool: Apple's container (Macs with Apple silicon and macOS 26), or
# Docker (Docker Desktop, OrbStack, Colima, Docker Engine on Linux), or Podman.
apple_ok() { [ "$OS" = Darwin ] && [ "$(uname -m)" = arm64 ] && [ "$(sw_vers -productVersion | cut -d. -f1)" -ge 26 ]; }
runtimes_found() {
  if apple_ok && command -v container >/dev/null; then echo container; fi
  if command -v docker >/dev/null; then echo docker; fi
  if command -v podman >/dev/null; then echo podman; fi
  return 0
}
default_runtime() {
  local r; r=$(runtimes_found | sed -n 1p)
  if [ -n "$r" ]; then echo "$r"; elif apple_ok; then echo container; else echo none; fi
}
RT=${BOX_RUNTIME:-$(conf_get runtime)}
[ -n "$RT" ] || RT=$(default_runtime)

if [ "$OS" = Darwin ] && [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
  TS=/Applications/Tailscale.app/Contents/MacOS/Tailscale
else
  TS=tailscale
fi

# With the front door on (agent-box door on, macOS), it owns 6080 and the box's viewer moves to 6090.
# Door services: ours, and any older install that runs box-door.py under another label.
door_plists() {
  if [ "$OS" = Darwin ]; then grep -l 'box-door\.py' "$HOME"/Library/LaunchAgents/*.plist 2>/dev/null; fi
  return 0
}
door_on() {
  local p
  while IFS= read -r p; do
    [ -n "$p" ] && launchctl print "gui/$(id -u)/$(basename "$p" .plist)" >/dev/null 2>&1 && return 0
  done < <(door_plists)
  return 1
}
door_remove() {
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    launchctl bootout "gui/$(id -u)/$(basename "$p" .plist)" 2>/dev/null || true
    rm -f "$p"
  done < <(door_plists)
}
viewer_port() { if [ -z "${BOX_VIEW_PORT:-}" ] && door_on; then echo 6090; else echo "$VIEW_PORT"; fi; }

# Colima and Podman on a Mac run their own Linux VM, which agent-box starts and
# stops. Setup records it, because Colima removes its Docker context when stopped.
VM=$(conf_get vm)
colima_ctx() { [ "$RT" = docker ] && [ "$VM" = colima ] && command -v colima >/dev/null; }
podman_vm() { [ "$RT" = podman ] && [ "$OS" = Darwin ]; }

ensure_system() {
  case "$RT" in
    container)
      container system status >/dev/null 2>&1 || container system start --disable-kernel-install >/dev/null ;;
    docker|podman)
      "$RT" info >/dev/null 2>&1 && return 0
      if colima_ctx; then colima start >/dev/null 2>&1 || true
      elif podman_vm; then podman machine start >/dev/null 2>&1 || true; fi
      "$RT" info >/dev/null 2>&1 || {
        echo "agent-box: $RT isn't running. Start it (Docker Desktop, OrbStack, 'colima start' or 'podman machine start') and try again" >&2; exit 1; } ;;
    *)
      echo "agent-box: no container tool found; run 'agent-box setup'" >&2; exit 1 ;;
  esac
}
# Stop the container service or VM too, unless other containers still use it.
stop_system() {
  local what others
  if [ "$RT" = container ]; then what="container service"
  elif colima_ctx; then what="Colima VM"
  elif podman_vm; then what="Podman VM"
  else return 0; fi
  if [ "$RT" = container ]; then others=$(container list -q 2>/dev/null | grep -vx "$NAME" || true)
  else others=$("$RT" ps -q 2>/dev/null || true); fi
  if [ -n "$others" ]; then echo "agent-box: left the $what running, because other containers use it"; return 0; fi
  case "$what" in
    "container service") container system stop ;;
    "Colima VM") colima stop ;;
    "Podman VM") podman machine stop ;;
  esac >/dev/null 2>&1 || true
  echo "agent-box: $what stopped"
}

state() {
  local s
  if [ "$RT" = container ]; then
    s=$(container inspect "$NAME" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["status"]["state"])' 2>/dev/null) || true
  else
    s=$("$RT" inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null) || true
  fi
  echo "${s:-absent}"
}
running() { [ "$(state)" = running ]; }
need_box() { running || { echo "agent-box: not running (run 'agent-box up')" >&2; exit 1; }; }
in_box() { "$RT" exec "$@"; }   # in_box [-i] [-u agent] <container> <cmd...>
vault() { in_box -u agent "$NAME" box-vault "$@"; }

image_ok() { "$RT" image inspect "$IMAGE" >/dev/null 2>&1; }
image_tags() {
  if [ "$RT" = container ]; then container image list -q 2>/dev/null | sed -n 's/^agent-box://p'
  else "$RT" images agent-box --format '{{.Tag}}' 2>/dev/null; fi
  return 0
}
image_rm() { if [ "$RT" = container ]; then container image delete "$1"; else "$RT" image rm "$1"; fi; }
build_quiet() {
  "$0" build >/tmp/agent-box-build.log 2>&1 || { tail -n 20 /tmp/agent-box-build.log >&2; exit 1; }
}

# Phone viewer address, only once it's published on the tailnet (see README).
view_tailnet() {
  "$TS" serve status 2>/dev/null | grep ':8443' >/dev/null || return 1
  local host
  host=$("$TS" status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null) || return 1
  echo "https://$host:8443/"
}

info() {
  echo "agent-box: running ($RT)"
  echo "  browser control (CDP): $CDP"
  echo "  viewer on this machine: $VIEW_LOCAL"
  local t
  if t=$(view_tailnet); then echo "  viewer from phone:      $t (Tailscale)"
  else echo "  viewer from phone:      not published (see $HERE/README.md)"; fi
  echo "  stops after ${BOX_IDLE_MINUTES:-20} min idle; 'agent-box down' stops it now"
}

case "${1:-help}" in
  setup)
    # One-time install on this machine; safe to re-run, for example after an update.
    shift; skills=1; dirs=(); want=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --skills-dir) dirs+=("${2:?--skills-dir needs a folder}"); shift 2 ;;
        --no-skills) skills=0; shift ;;
        --runtime) want="${2:?--runtime needs container, docker or podman}"; shift 2 ;;
        *) echo "usage: agent-box setup [--runtime container|docker|podman] [--skills-dir DIR]... [--no-skills]" >&2; exit 2 ;;
      esac
    done
    ask() { [ -t 0 ] && [ -t 1 ]; }   # a person at a terminal; agents pass options instead
    case "$OS" in Darwin|Linux) ;; *) echo "agent-box: needs macOS or Linux" >&2; exit 1 ;; esac

    # 1. Which container tool.
    if [ -z "$want" ]; then
      found=$(runtimes_found | tr '\n' ' ')
      want=$(default_runtime)
      if ask && [ "$(echo "$found" | wc -w)" -gt 1 ]; then
        printf 'Container tools found: %s\nWhich one should run the box? Press Enter for %s, or type another: ' "$found" "$want"
        read -r answer || answer=""
        [ -z "$answer" ] || want=$answer
      fi
    fi
    case "$want" in
      container) apple_ok || { echo "agent-box: Apple's container needs a Mac with Apple silicon and macOS 26; use --runtime docker or podman" >&2; exit 1; } ;;
      docker|podman) command -v "$want" >/dev/null || { echo "agent-box: $want isn't installed" >&2; exit 1; } ;;
      none) echo "agent-box: install Docker (Docker Desktop, OrbStack, Colima or Docker Engine) or Podman, then run setup again" >&2; exit 1 ;;
      *) echo "agent-box: unknown container tool '$want' (container, docker or podman)" >&2; exit 2 ;;
    esac
    RT=$want

    # 2. Where the agent skill goes.
    if [ "$skills" = 1 ] && [ ${#dirs[@]} -eq 0 ]; then
      dirs=("${SKILL_DIRS[@]}")
      if ask; then
        echo "Agents learn to use the box from a skill. It goes in these folders by default:"
        printf '  %s\n' "${dirs[@]}"
        printf 'Add it there? Press Enter for yes, type n for no, or type other folders: '
        read -r answer || answer=""
        case "$answer" in
          ""|y|Y|yes) ;;
          n|N|no) skills=0 ;;
          *) read -r -a dirs <<< "$answer"; dirs=("${dirs[@]/#\~/$HOME}") ;;
        esac
      fi
    fi

    # 3. Tools, image and skill.
    if [ "$RT" = container ] && ! command -v container >/dev/null; then
      command -v brew >/dev/null || { echo "agent-box: install Homebrew first, or Apple's container from https://github.com/apple/container/releases" >&2; exit 1; }
      echo "agent-box: installing Apple's container tool (Homebrew)"
      brew install container
    fi
    if ! command -v playwright-cli >/dev/null; then
      echo "agent-box: installing playwright-cli (npm)"
      npm install -g @playwright/cli@latest
    fi
    if [ "$RT" = container ]; then
      container system status >/dev/null 2>&1 || container system start --enable-kernel-install
    else
      ensure_system
    fi
    conf_set runtime "$RT"
    if [ "$RT" = docker ] && [ "$(docker context show 2>/dev/null)" = colima ]; then conf_set vm colima; else conf_set vm none; fi
    if ! image_ok; then
      echo "agent-box: building the box image with $RT (about 3 minutes; log in /tmp/agent-box-build.log)"
      build_quiet
    fi
    if [ "$skills" = 1 ]; then
      for d in "${dirs[@]}"; do
        if [ -e "$d/agent-box" ] && [ ! -L "$d/agent-box" ]; then
          echo "agent-box: skipped $d: it already has an agent-box folder that isn't a link" >&2; continue
        fi
        mkdir -p "$d"; ln -sfn "$SKILL" "$d/agent-box"
        echo "agent-box: skill linked in $d"
      done
      echo "agent-box: ready, using $RT. New agent sessions find the 'agent-box' skill. Watch the box at $VIEW_LOCAL"
    else
      echo "agent-box: ready, using $RT, without the skill: point agents at $SKILL/SKILL.md. Watch the box at $VIEW_LOCAL"
    fi
    echo "  For the phone viewer and password vault, see $HERE/README.md" ;;
  uninstall)
    # Undo setup. --all also deletes the image and the box's storage (logins and password vault).
    shift; all=0; dirs=("${SKILL_DIRS[@]}")
    while [ $# -gt 0 ]; do
      case "$1" in
        --all) all=1; shift ;;
        --skills-dir) dirs+=("${2:?--skills-dir needs a folder}"); shift 2 ;;
        *) echo "usage: agent-box uninstall [--skills-dir DIR]... [--all]" >&2; exit 2 ;;
      esac
    done
    for d in "${dirs[@]}"; do
      if [ -L "$d/agent-box" ]; then rm "$d/agent-box"; echo "agent-box: removed the skill from $d"; fi
    done
    if door_on; then "$0" door off; fi
    if [ "$all" = 1 ]; then
      if running; then "$0" down >/dev/null; fi
      ensure_system
      for t in $(image_tags); do image_rm "agent-box:$t" >/dev/null 2>&1 || true; done
      "$RT" volume rm "$VOLUME" >/dev/null 2>&1 || true
      echo "agent-box: deleted the image and the box's storage"
    fi
    "$0" off
    rm -f "$CONF"
    echo "agent-box: uninstalled. Finish with: npm rm -g agent-box" ;;
  up)
    ensure_system
    if ! running; then
      # A stopped box that was not cleaned up yet would block the name.
      if [ "$(state)" != absent ]; then "$RT" rm "$NAME" >/dev/null 2>&1 || true; fi
      if ! image_ok; then
        echo "agent-box: building the image first (first run or update, about 3 minutes)" >&2
        build_quiet
      fi
      if ! "$RT" volume inspect "$VOLUME" >/dev/null 2>&1; then
        if [ "$RT" = container ]; then container volume create -s 4G "$VOLUME" >/dev/null
        else "$RT" volume create "$VOLUME" >/dev/null; fi
      fi
      # Apple's container runs each box in its own VM. Docker and Podman share one
      # kernel and block the user namespaces Chromium's sandbox needs, so they get
      # Playwright's seccomp profile: Docker's default plus clone, setns and unshare.
      if [ "$RT" = container ]; then extra=(-c "${BOX_CPUS:-2}")
      else extra=(--cpus "${BOX_CPUS:-2}" --security-opt "seccomp=$HERE/chromium-seccomp.json"); fi
      "$RT" run -d --rm --name "$NAME" --init \
        -m "${BOX_MEMORY:-2G}" "${extra[@]}" --shm-size 1G \
        -e IDLE_MINUTES="${BOX_IDLE_MINUTES:-20}" \
        -e SCREEN_WIDTH="${BOX_WIDTH:-1280}" -e SCREEN_HEIGHT="${BOX_HEIGHT:-800}" \
        -v "$VOLUME":/data \
        -p "127.0.0.1:$(viewer_port):6080" -p "127.0.0.1:$CDP_PORT:9223" \
        "$IMAGE" >/tmp/agent-box-run.log 2>&1 || { cat /tmp/agent-box-run.log >&2; exit 1; }
    fi
    for _ in $(seq 120); do curl -sf -m 1 "$CDP/json/version" >/dev/null && break; sleep 0.5; done
    curl -sf -m 2 "$CDP/json/version" >/dev/null || { echo "agent-box: browser did not come up; see 'agent-box logs'" >&2; exit 1; }
    info ;;
  down)
    if running; then
      # Quit Chromium cleanly first; a plain stop signal can kill it unsaved.
      in_box "$NAME" box-quit-browser >/dev/null 2>&1 || true
      "$RT" stop -t 15 "$NAME" >/dev/null
    fi
    for _ in $(seq 20); do [ "$(state)" = absent ] && break; sleep 0.5; done
    echo "agent-box: stopped" ;;
  status)
    if running; then info; "$RT" stats --no-stream "$NAME" 2>/dev/null || true
    else echo "agent-box: stopped (run 'agent-box up'); container tool: $RT"; fi ;;
  url)
    echo "$VIEW_LOCAL"; view_tailnet || true ;;
  shot)
    # Screenshot of the whole desktop, for when the page alone is not enough.
    out="${2:-/tmp/agent-box-$(date +%Y%m%d-%H%M%S).png}"
    in_box "$NAME" sh -c 'DISPLAY=:1 scrot -o /tmp/shot.png'
    in_box "$NAME" cat /tmp/shot.png > "$out"; echo "$out" ;;
  x)
    # Raw mouse/keyboard on the desktop, e.g. `agent-box x mousemove 640 400 click 1`.
    shift; in_box "$NAME" env DISPLAY=:1 xdotool "$@" ;;
  exec)
    shift; in_box "$NAME" "$@" ;;
  logs)
    "$RT" logs "$NAME" ;;
  build)
    ensure_system
    "$RT" build -t "$IMAGE" -f "$HERE/Containerfile" "$HERE"
    # Drop the build cache (about 4.5 GB with Apple's container), older builds and unused layers.
    if [ "$RT" = container ]; then
      container builder stop >/dev/null 2>&1 || true
      container builder delete >/dev/null 2>&1 || true
    fi
    for t in $(image_tags); do
      [ "$t" = "$TAG" ] || image_rm "agent-box:$t" >/dev/null 2>&1 || true
    done
    if [ "$RT" = container ]; then container image prune >/dev/null 2>&1 || true
    else "$RT" image prune -f --filter label=agent-box >/dev/null 2>&1 || true; fi ;;
  door)
    # Front door (macOS): always-on 15 MB helper on 6080 that starts the box when
    # the viewer address is opened and shows a "starting" page meanwhile.
    [ "$OS" = Darwin ] || { echo "agent-box: the front door is only for macOS so far" >&2; exit 1; }
    agents="$HOME/Library/LaunchAgents"
    case "${2:-}" in
      on)
        was_on=0; door_on && was_on=1
        door_remove
        mkdir -p "$agents" "$HOME/Library/Logs"
        path="$(dirname "$(command -v "$RT")"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        sed -e "s|__HERE__|$HERE|g" -e "s|__LABEL__|$DOOR|" -e "s|__PATH__|$path|" \
            -e "s|__LOG__|$HOME/Library/Logs/agent-box-door.log|" "$HERE/agent-box-door.plist" > "$DOOR_PLIST"
        if [ "$was_on" = 0 ] && running; then "$0" down >/dev/null; fi   # its viewer must move to 6090
        launchctl bootstrap "gui/$(id -u)" "$DOOR_PLIST"
        echo "agent-box: front door on; open the viewer address any time" ;;
      off)
        door_remove
        if running; then "$0" down >/dev/null; fi
        echo "agent-box: front door off" ;;
      *) door_on && echo "agent-box: front door on" || echo "agent-box: front door off" ;;
    esac ;;
  secret)
    # The box's password manager (KeePassXC, inside the box). Values never print.
    # New passwords come from a private secret prompt that writes a file
    # (T3 Code: request_secret with delivery "file"), so they never enter the chat.
    need_box
    case "${2:-}" in
      save)
        # agent-box secret save <name> --from-file <path> [--user <username>] [--url <url>]
        name="${3:-}"; shift 3 || true
        file=""; user=""; url=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --from-file) file="${2:-}"; shift 2 ;;
            --user) user="${2:-}"; shift 2 ;;
            --url) url="${2:-}"; shift 2 ;;
            *) echo "agent-box: unknown option $1" >&2; exit 2 ;;
          esac
        done
        [ -n "$name" ] && [ -f "$file" ] || { echo "usage: agent-box secret save <name> --from-file <path> [--user <username>] [--url <url>]" >&2; exit 2; }
        tr -d '\r\n' < "$file" | in_box -i -u agent "$NAME" box-vault add "$name" "$user" "$url" ;;
      list) vault list ;;
      rm)   vault rm "${3:?usage: agent-box secret rm <name>}" ;;
      open) vault gui; echo "agent-box: the password manager is open on the box's screen" ;;
      *) echo "usage: agent-box secret save <name> --from-file <path> [--user U] [--url URL] | list | rm <name> | open" >&2; exit 2 ;;
    esac ;;
  type-secret)
    # Type a vault entry into the focused field in the box, without printing it.
    #   agent-box type-secret <name> [--username | --totp] [--no-enter]
    #   agent-box type-secret --from-file <path> [--no-enter]     (one-time use)
    # For passwords it presses Enter, then clears any password still left in a
    # field (e.g. a failed login): page snapshots show password values.
    shift; need_box
    field=password; enter=1; name=""; file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --username) field=username; enter=0; shift ;;
        --totp) field=totp; shift ;;
        --no-enter) enter=0; shift ;;
        --from-file) file="${2:-}"; shift 2 ;;
        *) name="$1"; shift ;;
      esac
    done
    if [ -n "$file" ]; then
      [ -f "$file" ] || { echo "agent-box: no such file" >&2; exit 2; }
      in_box "$NAME" env DISPLAY=:1 xdotool search --onlyvisible --class chromium windowactivate --sync %1 >/dev/null 2>&1 || true
      tr -d '\r\n' < "$file" | in_box -i "$NAME" env DISPLAY=:1 xdotool type --clearmodifiers --delay 15 --file -
    else
      [ -n "$name" ] || { echo "usage: agent-box type-secret <name> [--username|--totp] [--no-enter]" >&2; exit 2; }
      vault type "$name" "$field" || exit 1
    fi
    if [ "$enter" = 0 ]; then
      [ "$field" = password ] && echo "agent-box: typed it; submit the form before any snapshot (snapshots show password fields)" || echo "agent-box: typed it"
    else
      in_box "$NAME" env DISPLAY=:1 xdotool key Return
      if [ "$field" = password ]; then
        sleep 3
        in_box -i "$NAME" python3 - <<'PY' 2>/dev/null || true
import json, urllib.request, websocket
js = ("document.querySelectorAll('input[type=password]').forEach(i => { if (i.value) {"
      " i.value = ''; i.dispatchEvent(new Event('input', {bubbles: true})); } })")
for t in json.load(urllib.request.urlopen("http://127.0.0.1:9222/json/list", timeout=2)):
    if t.get("type") != "page":
        continue
    try:
        ws = websocket.create_connection(t["webSocketDebuggerUrl"], timeout=3)
        ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {"expression": js}}))
        ws.recv(); ws.close()
    except Exception:
        pass
PY
      fi
      echo "agent-box: typed it and pressed Enter"
    fi ;;
  off)
    # Stop the box, and the container service or VM when nothing else uses it.
    if running; then "$0" down >/dev/null; fi
    echo "agent-box: box stopped"
    stop_system ;;
  runtime)
    echo "$RT" ;;
  version|--version)
    sed -n 's/^ *"version": *"\(.*\)".*/\1/p' "$HERE/package.json" ;;
  *)
    cat <<'EOF'
agent-box up       start the box if needed (about 7 s) and print its addresses
agent-box down     stop the box now (it also stops itself when idle)
agent-box status   whether it runs, and its CPU and memory use
agent-box url      viewer addresses (this machine, and phone over Tailscale)
agent-box shot [file.png]   screenshot of the whole desktop
agent-box x <xdotool args>  mouse and keyboard on the desktop
agent-box exec <cmd>        run a command inside the box
agent-box logs     the box's log
agent-box runtime  the container tool in use (container, docker or podman)
agent-box build    rebuild the image
agent-box off      stop the box, and the container service or VM if nothing else uses it
agent-box door on|off   (macOS) always-on helper so the viewer address starts the box itself
agent-box setup [--runtime container|docker|podman] [--skills-dir DIR]... [--no-skills]
                   install tools, image and agent skill (re-run after updates)
agent-box uninstall [--all]   undo setup; --all also deletes logins and passwords

Passwords (KeePassXC vault inside the box; values never print):
agent-box secret list                 entry names
agent-box secret save <name> --from-file <path> [--user U] [--url URL]
                                      add one (file from a private secret prompt)
agent-box secret rm <name>            delete one
agent-box secret open                 open the password manager on the box's screen
agent-box type-secret <name> [--username | --totp] [--no-enter]
                 click the field first; types it there. For passwords it presses
                 Enter, then clears leftover password fields.

Agents: read the agent-box skill. In short: `agent-box up`, then
`playwright-cli -s=<your-session> attach --cdp=<the browser control address it printed>`,
drive the page (tab-new, find, click, screenshot) and finish with
`playwright-cli -s=<your-session> detach`.
Never put a password in a command, file or chat: use agent-box type-secret.
EOF
    ;;
esac
